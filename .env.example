DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5432/ev_cms?sslmode=disable
HTTP_ADDR=0.0.0.0:8080
CORS_ALLOW_ALL=true
API_DOCS_ENABLED=true
LOG_LEVEL=DEBUG

# Idempotent first-superadmin bootstrap. Existing passwords are never changed.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-long-unique-password
SUPERADMIN_FULL_NAME=Platform Superadmin

AUTH_ISSUER=ev-cms
AUTH_AUDIENCE=ev-cms-api
AUTH_ACCESS_TTL=15m
AUTH_SESSION_TTL=720h
AUTH_OTP_TTL=10m
AUTH_OTP_RESEND_COOLDOWN=1m
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_DURATION=15m
AUTH_RATE_LIMIT_WINDOW=15m
AUTH_RATE_LIMIT_MAX=100

PLATFORM_EVENT_RETENTION=168h
PLATFORM_REALTIME_POLL_INTERVAL=1s
PLATFORM_REALTIME_HEARTBEAT_INTERVAL=15s
PLATFORM_REALTIME_BATCH_SIZE=100
PLATFORM_WORKER_STALE_AFTER=2m
PLATFORM_MAINTENANCE_INTERVAL=1m

# Generate independent random values. Signing/OTP keys decode to at least
# 32 bytes; AES-GCM keys decode to exactly 32 bytes.
JWT_SIGNING_KEY_B64=
JWT_ENCRYPTION_KEY_B64=
OTP_HMAC_KEY_B64=
MAIL_OUTBOX_ENCRYPTION_KEY_ID=v1
MAIL_OUTBOX_ENCRYPTION_KEY_B64=
CREDENTIAL_ENCRYPTION_KEY_ID=v1
CREDENTIAL_ENCRYPTION_KEY_B64=

# Hostinger SMTP. Administrative login and recovery require mail delivery.
# SMTP_PASSWORD must be supplied only in the ignored .env or process environment.
MAIL_ENABLED=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=team@transev.in
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=team@transev.in
SMTP_FROM_NAME=TransEV CMS
SMTP_USE_TLS=false
SMTP_USE_SSL=true
MAIL_WORKER_POLL_INTERVAL=2s
MAIL_SEND_TIMEOUT=15s
CHARGER_CONNECTION_URL=