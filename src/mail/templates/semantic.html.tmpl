{{define "mail-start"}}<!doctype html><html><body style="font-family:Arial,sans-serif;color:#1f2937"><p>Hi {{.RecipientName}},</p>{{end}}
{{define "mail-end"}}<p style="color:#4b5563">If you did not expect this message, contact your administrator.</p></body></html>{{end}}
{{define "action"}}<p><a href="{{.ActionURL}}">Continue</a></p>{{end}}
{{define "LOGIN_OTP"}}{{template "mail-start" .}}<p>Use this sign-in code: <strong>{{.Code}}</strong></p><p>It expires {{.ExpiresAt}}. Do not share it.</p>{{template "action" .}}{{template "mail-end" .}}{{end}}
{{define "PASSWORD_RESET_OTP"}}{{template "mail-start" .}}<p>A password reset was requested. Your verification code is <strong>{{.Code}}</strong>.</p><p>It expires {{.ExpiresAt}}. Receiving this email has not changed your password.</p>{{template "action" .}}{{template "mail-end" .}}{{end}}
{{define "CUSTOMER_LOGIN_OTP"}}{{template "LOGIN_OTP" .}}{{end}}
{{define "CUSTOMER_SIGNUP_OTP"}}{{template "mail-start" .}}<p>Use this verification code: <strong>{{.Code}}</strong></p><p>It expires {{.ExpiresAt}}.</p>{{template "action" .}}{{template "mail-end" .}}{{end}}
{{define "CUSTOMER_PASSWORD_RESET_OTP"}}{{template "PASSWORD_RESET_OTP" .}}{{end}}
{{define "CPO_STAFF_NEW_IDENTITY"}}{{template "mail-start" .}}<p>You have been added to {{.CPOName}} as <strong>{{.Role}}</strong>.</p><p>Sign in using the temporary password below, then change it before using CPO operations.</p><p>Temporary password: <strong>{{.TemporaryPassword}}</strong></p>{{template "action" .}}{{template "mail-end" .}}{{end}}
{{define "CPO_STAFF_EXISTING_IDENTITY"}}{{template "mail-start" .}}<p>You have been added to {{.CPOName}} as <strong>{{.Role}}</strong>. Use your existing TransEV credentials to sign in.</p>{{template "action" .}}{{template "mail-end" .}}{{end}}
{{define "CPO_ONBOARDING_RESENT"}}{{template "mail-start" .}}<p>Use your existing TransEV credentials to access {{.CPOName}}. Passwords are never resent; use password recovery if needed.</p>{{template "action" .}}{{template "mail-end" .}}{{end}}
{{define "CPO_STAFF_ROLE_CHANGED"}}{{template "mail-start" .}}<p>Your role for {{.CPOName}} is now <strong>{{.Role}}</strong>. Use your existing TransEV credentials to sign in.</p>{{template "action" .}}{{template "mail-end" .}}{{end}}
{{define "CPO_STAFF_SUSPENDED"}}{{template "mail-start" .}}<p>Your access to {{.CPOName}} has been suspended. This affects only this CPO membership.</p>{{template "action" .}}{{template "mail-end" .}}{{end}}
{{define "CPO_STAFF_REACTIVATED"}}{{template "mail-start" .}}<p>Your access to {{.CPOName}} has been restored. Use your existing TransEV credentials to sign in.</p>{{template "action" .}}{{template "mail-end" .}}{{end}}
{{define "CPO_STAFF_REVOKED"}}{{template "mail-start" .}}<p>Your access to {{.CPOName}} has been removed. This affects only this CPO membership.</p>{{template "action" .}}{{template "mail-end" .}}{{end}}
{{define "CPO_SUBSCRIPTION_EXPIRY_WARNING"}}{{template "mail-start" .}}<p>{{.CPOName}} subscription ends on {{.ExpiresAt}}.</p>{{template "action" .}}{{template "mail-end" .}}{{end}}
{{define "CPO_SUBSCRIPTION_EXPIRED"}}{{template "mail-start" .}}<p>{{.CPOName}} subscription expired on {{.ExpiresAt}}. New customer charging starts and recharge orders remain unavailable until a platform administrator renews the subscription.</p>{{template "action" .}}{{template "mail-end" .}}{{end}}
{{define "CPO_SUPPORT_TICKET_CREATED"}}{{template "mail-start" .}}<p>{{.CPOName}} received your support ticket, “{{.SupportSubject}}”. Its current status is {{.SupportStatus}} as of {{.OccurredAt}}.</p>{{template "action" .}}{{template "mail-end" .}}{{end}}
{{define "CPO_SUPPORT_TICKET_PLATFORM_REPLY"}}{{template "mail-start" .}}<p>The platform replied to “{{.SupportSubject}}”. Its current status is {{.SupportStatus}} as of {{.OccurredAt}}. Open the support ticket to read the reply.</p>{{template "action" .}}{{template "mail-end" .}}{{end}}
{{define "CPO_SUPPORT_TICKET_RESOLVED"}}{{template "mail-start" .}}<p>“{{.SupportSubject}}” was marked RESOLVED at {{.OccurredAt}}. Its current status is {{.SupportStatus}}.</p>{{template "action" .}}{{template "mail-end" .}}{{end}}
{{define "CPO_SUPPORT_TICKET_CLOSED"}}{{template "mail-start" .}}<p>“{{.SupportSubject}}” was marked CLOSED at {{.OccurredAt}}. Its current status is {{.SupportStatus}}.</p>{{template "action" .}}{{template "mail-end" .}}{{end}}
{{define "CPO_SUPPORT_TICKET_REOPENED"}}{{template "mail-start" .}}<p>“{{.SupportSubject}}” was reopened at {{.OccurredAt}}. Its current status is {{.SupportStatus}}.</p>{{template "action" .}}{{template "mail-end" .}}{{end}}
